# /opt/imot-mcp/imot-mcp.env — chmod 600, never committed.
#
# IMOT_MCP_TOKENS is "label:secret" pairs, comma separated. Each colleague gets
# their own entry so one can be revoked without touching the others, and so the
# usage log records who asked what.
#
# Generate a secret with:  openssl rand -base64 36 | tr -d '/+=' | head -c 43
# The secret is the last path segment of the endpoint:
#   https://imot-mcp.pixelautomate.com/mcp/<secret>
IMOT_MCP_TOKENS=victor:REPLACE_WITH_A_LONG_RANDOM_SECRET,colleague:REPLACE_WITH_A_LONG_RANDOM_SECRET

# Cache freshness: a repeat question inside this window never touches imot.bg.
IMOT_MCP_SEARCH_TTL=30m
IMOT_MCP_DETAIL_TTL=6h

# Live scraping politeness, shared by every colleague.
IMOT_MCP_MAX_CONCURRENT=1
IMOT_MCP_MIN_SPACING=2500ms

# Shared budget protecting the imot-vpn egress that Market Radar also uses.
IMOT_MCP_LIVE_QUOTA=30
IMOT_MCP_GLOBAL_QUOTA=150
IMOT_MCP_QUOTA_WINDOW=1h

# Coverage per live search. Pages are capped so no single question can turn into
# a minutes-long scrape.
IMOT_MCP_DEFAULT_PAGES=1
IMOT_MCP_MAX_PAGES=3
IMOT_MCP_DEFAULT_LIMIT=40
IMOT_MCP_MAX_LIMIT=80

# Reply to POSTs with application/json rather than an SSE stream. Keep this true
# for ChatGPT: its MCP client advertises only `Accept: application/json` and
# cannot read an SSE-framed reply. Set false only for a client that needs SSE.
IMOT_MCP_JSON_RESPONSE=true
